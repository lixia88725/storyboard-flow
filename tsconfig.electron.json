{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "outDir": "dist-electron",
    "rootDir": "src",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "types": [
      "node",
      "electron"
    ]
  },
  "include": [
    "src/platform/main/**/*.ts",
    "src/platform/preload/**/*.ts",
    "src/platform/contracts/**/*.ts",
    "src/project-files/main/**/*.ts"
  ],
  "exclude": [
    "**/*.test.ts"
  ]
}
