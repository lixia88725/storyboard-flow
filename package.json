{
  "name": "storyboard-flow",
  "productName": "Storyboard Flow",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "main": "dist-electron/platform/main/flowEditorEntry.js",
  "scripts": {
    "dev": "npm run build:electron && concurrently -k \"vite\" \"wait-on http://localhost:5173 && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .\"",
    "build": "npm run typecheck && vite build && npm run build:electron",
    "build:electron": "node scripts/clean-electron-build.mjs && tsc -p tsconfig.electron.json",
    "package:macos": "npm run build && npm run prepare:package-resources && node scripts/package-macos-app.mjs",
    "package:windows": "npm run build && npm run prepare:package-resources && node scripts/package-windows-portable.mjs",
    "prepare:package-resources": "npm run build:electron && node scripts/prepare-package-resources.mjs",
    "setup:photoshop-tiff-deps": "python3 -m pip install --target vendor/python/photoshop-tiff -r vendor/python/photoshop-tiff/requirements.txt",
    "smoke:performance": "node scripts/flow-workbench-drag-perf.cjs",
    "check:preload": "node scripts/check-preload-sync.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.electron.json --noEmit",
    "smoke:workbench": "node scripts/flow-workbench-smoke.mjs",
    "setup:photocraft": "node scripts/setup-photocraft.mjs",
    "build:photocraft": "cargo build --locked --manifest-path native/photocraft/Cargo.toml --all-targets"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "^36.3.1",
    "konva": "^9.3.20",
    "lucide-react": "^1.17.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-konva": "^19.0.3",
    "sharp": "^0.34.2"
  },
  "devDependencies": {
    "@types/node": "^22.15.21",
    "@types/react": "^19.1.5",
    "@types/react-dom": "^19.1.5",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vitest": "^3.1.4",
    "wait-on": "^8.0.3"
  },
  "allowScripts": {
    "electron@36.9.5": true,
    "esbuild@0.25.12": true,
    "sharp@0.34.5": true
  }
}
